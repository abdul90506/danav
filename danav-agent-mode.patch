+  assert.deepEqual(displayArgs('edit_file', { path: 'a.js', old_string: big, new_string: big }), { path: 'a.js' });
+  assert.deepEqual(displayArgs('multi_edit', { path: 'a.js', edits: [{ old_string: big, new_string: big }] }), { path: 'a.js' });
