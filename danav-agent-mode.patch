+  if (path) out.path = clip(path, 300);
+  if (name === 'run_command') {
+    const c = grab('command') ?? grab('cmd');
+    if (c) out.command = clip(c, 600);
+  }
+  if (name === 'move_file') {
+    const f = grab('from');
+    const t = grab('to');
+    if (f) out.from = clip(f, 300);
+    if (t) out.to = clip(t, 300);
+  }
+  for (const key of ['query', 'url', 'pattern']) {
+    const v = grab(key);
+    if (v) out[key] = clip(v, 300);
