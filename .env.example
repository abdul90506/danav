# BlackDesi AI Chat — copy this file to `.env` (it is gitignored) and fill in what you use.
# Nothing in here is ever sent to the browser or to the AI model.

# --- Agent mode: cloud sandbox (https://novita.ai -> Key Management) ---------
NOVITA_API_KEY=

# --- Model providers (optional: you can also add them in Settings) ----------
# GEMINI_API_KEY=
# VYCE_API_KEY=

# --- Chat web tools ---------------------------------------------------------
# The TMDB key behind movie_search. The default is TMDB's published sample key,
# shared by everyone who runs this app; a key of your own gets a private quota.
# TMDB_API_KEY=
# Optional self-hosted catalogue API used when TMDB returns nothing.
# FLIXRAID_API_URL=https://example.com/flixraid

# --- Agent mode: advanced (all optional) -------------------------------------
# Where NEW local workspaces are created (default: ~/blackdesi-workspaces)
# BLACKDESI_WORKSPACES_DIR=
# Let a local workspace point at ANY folder, not only the one above (1 = yes)
# BLACKDESI_ALLOW_ANY_LOCAL_PATH=
# Agent routes only answer on localhost. To serve BlackDesi on another hostname
# (a tunnel, a domain) list it here -- and put the app behind authentication first:
# the agent can run commands.   e.g.  .trycloudflare.com,my-host.example.com
# BLACKDESI_ALLOWED_HOSTS=
# That switch also turns on the preview access code (below). Set it to your own
# code here, or read the one BlackDesi generates for you:
# BLACKDESI_PREVIEW_TOKEN=
# Serving BlackDesi publicly without a code at all (only if something else in front
# of it already authenticates every visitor):
# BLACKDESI_DISABLE_PREVIEW_AUTH=
# --- Auto-pause: stop paying for a sandbox nobody is using -------------------
# A cloud sandbox bills while it is RUNNING; a paused one keeps its files and
# its processes and costs nothing. BlackDesi pauses one as soon as it goes quiet.
# Silence in a workspace before its sandbox is paused (default: 3 minutes)
# BLACKDESI_SANDBOX_IDLE_PAUSE_SECONDS=180
# A run just finished -- a stronger signal, so a shorter clock (default: 90s)
# BLACKDESI_SANDBOX_RUN_GRACE_SECONDS=90
# Backstop: Novita pauses it itself this long after the last activity, in case
# this server dies. Refreshed on every use (default: 15 minutes)
# NOVITA_SANDBOX_TIMEOUT_MINUTES=15

# Limits for one agent run
# BLACKDESI_AGENT_MAX_STEPS=80
# BLACKDESI_AGENT_MAX_RUN_MINUTES=45
# BLACKDESI_AGENT_COMMAND_TIMEOUT_SECONDS=120

# --- How a file shows up in the chat while it is being made ------------------
# Only some endpoints stream a tool call's ARGUMENTS. Gemini does once BlackDesi
# sends stream_function_call_arguments, so its write_file row follows the model
# token by token and counts up on its own -- none of the settings below apply.
#
# Every other endpoint measured here (agnes, claude, deepseek, qwen via Vyce;
# DeepSeek-V4-Flash via Baseten) sends the WHOLE call in one SSE frame -- check
# any model yourself with:  node scripts/probe-raw.js <model id>
# With no token stream to follow, and a local write finishing in a few
# milliseconds, the row naming the file appeared and vanished in ~40ms.
#
# 1) Such a body is written to the real file in chunks, so the row reads
#    "Creating app.js +0" and climbs as those lines land. Every number is read
#    back off the file; only the cadence is chosen here. A long file arrives as
#    write_file plus several append_file parts, and each part climbs too.
#    Pacing never starts on a file this run has not read.
# BLACKDESI_REVEAL=1
# Reveal speed, in characters per second (default: 1100)
# BLACKDESI_REVEAL_CHARS_PER_SEC=1100
# Floor and cap on how long one reveal lasts, in ms (defaults: 900 / 4000)
# BLACKDESI_REVEAL_MIN_MS=900
# BLACKDESI_REVEAL_MAX_MS=4000
#
# 2) A row that names a file is kept on screen at least this long, so a small
#    file (or an edit, which is not revealed) is still readable. It holds only
#    the row: nothing is invented, and the reported duration stays the tool's
#    real one. Set 0 to turn the hold off.
# BLACKDESI_ROW_MIN_MS=420
