# Danav AI Chat — copy this file to `.env` (it is gitignored) and fill in what you use.
# Nothing in here is ever sent to the browser or to the AI model.

# --- Agent mode: cloud sandbox (https://novita.ai -> Key Management) ---------
NOVITA_API_KEY=

# --- Model providers (optional: you can also add them in Settings) ----------
# GEMINI_API_KEY=
# VYCE_API_KEY=

# --- Chat web tools ---------------------------------------------------------
# The TMDB key behind movie_search. The default is TMDB's published sample key,
# shared by everyone who runs this app; a key of your own gets a private quota.
# TMDB_API_KEY=
# Optional self-hosted catalogue API used when TMDB returns nothing.
# FLIXRAID_API_URL=https://example.com/flixraid

# --- Agent mode: advanced (all optional) -------------------------------------
# Where NEW local workspaces are created (default: ~/danav-workspaces)
# DANAV_WORKSPACES_DIR=
# Let a local workspace point at ANY folder, not only the one above (1 = yes)
# DANAV_ALLOW_ANY_LOCAL_PATH=
# Agent routes only answer on localhost. To serve Danav on another hostname
# (a tunnel, a domain) list it here -- and put the app behind authentication first:
# the agent can run commands.   e.g.  .trycloudflare.com,my-host.example.com
# DANAV_ALLOWED_HOSTS=
# That switch also turns on the preview access code (below). Set it to your own
# code here, or read the one Danav generates for you:
# DANAV_PREVIEW_TOKEN=
# Serving Danav publicly without a code at all (only if something else in front
# of it already authenticates every visitor):
# DANAV_DISABLE_PREVIEW_AUTH=
# --- Auto-pause: stop paying for a sandbox nobody is using -------------------
# A cloud sandbox bills while it is RUNNING; a paused one keeps its files and
# its processes and costs nothing. Danav pauses one as soon as it goes quiet.
# Silence in a workspace before its sandbox is paused (default: 3 minutes)
# DANAV_SANDBOX_IDLE_PAUSE_SECONDS=180
# A run just finished -- a stronger signal, so a shorter clock (default: 90s)
# DANAV_SANDBOX_RUN_GRACE_SECONDS=90
# Backstop: Novita pauses it itself this long after the last activity, in case
# this server dies. Refreshed on every use (default: 15 minutes)
# NOVITA_SANDBOX_TIMEOUT_MINUTES=15

# Limits for one agent run
# DANAV_AGENT_MAX_STEPS=80
# DANAV_AGENT_MAX_RUN_MINUTES=45
# DANAV_AGENT_COMMAND_TIMEOUT_SECONDS=120

# --- How a written file is revealed in the chat ------------------------------
# Every OpenAI-compatible endpoint measured here (agnes, gemini, claude,
# deepseek) hands over a whole write_file call in ONE stream frame -- there is no
# token stream to follow. Danav therefore reveals the body itself, at a pace a
# person can read, while writing it to disk line by line. The "+N" you see is a
# reading of the file that is really there.
# Reveal speed, in characters per second (default: 1100)
# DANAV_REVEAL_CHARS_PER_SEC=1100
# Floor and cap on how long one reveal lasts, in milliseconds (defaults: 800 / 2800)
# DANAV_REVEAL_MIN_MS=800
# DANAV_REVEAL_MAX_MS=2800
